# MarketPulse System Environment Variables

# Application
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Security
JWT_SECRET=marketpulse_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL in Docker / Production:
# DATABASE_URL="postgresql://marketpulse:marketpulse123@localhost:5432/marketpulse_db?schema=public"

# Redis & Caching
REDIS_URL=redis://localhost:6379

# AI & LLM Provider Configuration
OLLAMA_URL=http://localhost:11434
AI_MODEL=llama3
AI_FALLBACK_MODE=true

# Market Data Pipeline
MARKET_DATA_MODE=simulated
STREAM_INTERVAL_MS=1500
