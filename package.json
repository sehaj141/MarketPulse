{
  "name": "marketpulse",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade financial intelligence and stock research platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "web": "next dev -p 3000",
    "server": "ts-node-dev --project tsconfig.server.json --respawn --transpile-only src/server/main.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "ts-node --project tsconfig.server.json src/server/database/seed.ts",
    "test": "jest --passWithNoTests",
    "benchmark": "ts-node --project tsconfig.server.json src/server/benchmark.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.37.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.2.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
